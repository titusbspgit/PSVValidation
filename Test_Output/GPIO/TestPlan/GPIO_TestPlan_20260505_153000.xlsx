   <Row>
    <Cell><Data ss:Type="String">GPIO_TC_001</Data></Cell>
    <Cell><Data ss:Type="String">gpio_reg_wr_rd_test</Data></Cell>
    <Cell><Data ss:Type="String">Verify write/read functionality of key GPIO registers.</Data></Cell>
    <Cell><Data ss:Type="String">TestRepo/gpio/gpio_reg_wr_rd_test</Data></Cell>
