   <Row>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">GPIO</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">gpio_reg_wr_rd_test</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">Register Read/Write Validation</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">Phase 1: Reset default value verification - Read register after reset and verify default value matches specification</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">gp0_gpio_8</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">0xA001A000</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">0x0</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="Number">32</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">hreset_n</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">data_in</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">RO</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="Number">0</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">Determines the level gpio pin. Read returns the current value of the corresponding pin regardless of whether the pin is an input or an output</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">Phase 1 - Reset Default Verification</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">RO field: Read-only, retains reset default value 0 after reset. Cannot be written by software.</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">N/A (Read-Only)</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">https://github.com/titusbspgit/PSVValidation/tree/main/TestRepo/gpio/gpio_reg_wr_rd_test</Data></Cell>
   </Row>
   <Row>
