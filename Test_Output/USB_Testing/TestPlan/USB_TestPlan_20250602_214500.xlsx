<?xml version="1.0" encoding="UTF-8"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet">
 <Styles>
  <Style ss:ID="Header">
   <Font ss:Bold="1" ss:Color="#FFFFFF" ss:Size="11"/>
   <Interior ss:Color="#4472C4" ss:Pattern="Solid"/>
   <Alignment ss:WrapText="1" ss:Vertical="Top"/>
  </Style>
  <Style ss:ID="Data">
   <Alignment ss:WrapText="1" ss:Vertical="Top"/>
  </Style>
 </Styles>
 <Worksheet ss:Name="TestPlan">
  <Table>
   <Column ss:Width="40"/>
   <Column ss:Width="80"/>
   <Column ss:Width="250"/>
   <Column ss:Width="220"/>
   <Column ss:Width="400"/>
   <Column ss:Width="70"/>
   <Column ss:Width="60"/>
   <Column ss:Width="100"/>
   <Column ss:Width="100"/>
   <Column ss:Width="300"/>
   <Column ss:Width="400"/>
   <Column ss:Width="300"/>
   <Column ss:Width="300"/>
   <Column ss:Width="80"/>
   <Row>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Index</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">SS / Module</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Feature</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Test Case Name</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Test Description</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Speed</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Mode</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Memory Start Offset</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Memory End Offset</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Remarks</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Test Steps / Procedure</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Impacted Registers</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Validation / Acceptance Criteria</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Code Generation</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="Data"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">USB</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">USB Host Low-Speed Device Enumeration (xHCI)</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">usb_host_enumeration_ls</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">Verifies USB host-mode enumeration of a low-speed device through xHCI. Initializes PHY, configures port with wake enables, sets up DCBAA/Command Ring/Event Ring, starts host controller, detects port connect, performs port reset, issues Enable Slot and Address Device commands, and executes GET_DESCRIPTOR control transfer for device descriptor.</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">Low-Speed</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">Host</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">NA</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">NA</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">Default_IRQHandler uses logical AND (&amp;&amp;) instead of bitwise AND (&amp;). EP0 max packet size 8 bytes for low-speed. Three LSS SYSREG macros unresolved.</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">1. Initialize NIC and GIC interrupts&#10;2. Configure USB2 PHY&#10;3. Read host capability registers&#10;4. Configure port wake enables&#10;5. Set up DCBAA, Command Ring, Event Ring&#10;6. Configure interrupter registers&#10;7. Enable Slot Command and start host controller&#10;8. Detect port connect, perform port reset&#10;9. Set up Input Context, Address Device&#10;10. Execute GET_DESCRIPTOR control transfer&#10;11. Service interrupts via IRQ handler</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">GUSB2PHYCFG, HCSPARAMS1, SUPTPRT2_DW2, SUPTPRT3_DW2, PORTSC_20, DBOFF, CONFIG, DCBAAP_LO, DCBAAP_HI, CRCR_LO, CRCR_HI, ERSTSZ, ERDP_LO, ERDP_HI, ERSTBA_LO, ERSTBA_HI, IMOD, IMAN, USBCMD, USBSTS, DB</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">1. Port connect detected after host start&#10;2. Port reset completes successfully&#10;3. Enable Slot and Address Device commands complete&#10;4. GET_DESCRIPTOR returns device descriptor&#10;5. All interrupts serviced correctly&#10;6. GIC IRQ 84 cleared</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String"></Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="Data"><Data ss:Type="String">2</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">USB</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">USB Full-Speed Device Bulk Transfer (DWC3)</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">USB_FS_Device_Bulk_Transfer_test</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">Verifies USB device-mode bulk data transfer at full-speed using DWC3. Initializes event buffer, configures device registers, sets up EP0 and EP1 (bulk) endpoints, performs control transfer setup and bulk data transfers with interrupt-driven completion.</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">Full-Speed</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">Device</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">NA</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">NA</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">Debug marker 0xdeadbee5 at 0xA0243ffc. LSS SYSREG macros unresolved. IRQ handler uses logical AND (&amp;&amp;) instead of bitwise AND (&amp;). +0x10 offset for EP1 endpoint.</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">1. Initialize NIC and GIC interrupts&#10;2. Configure event buffer&#10;3. Read global control and device config&#10;4. Poll DSTS for microframe alignment&#10;5. Configure device and enable endpoints&#10;6. Configure USB2 PHY&#10;7. Set up EP0 and EP1 (bulk) via DEPCMD&#10;8. Execute control transfer setup&#10;9. Perform bulk data transfers&#10;10. Service interrupts via IRQ handler</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">GEVNTADRLO, GEVNTADRHI, GEVNTSIZ, GEVNTCOUNT, GCTL, DCFG, DSTS, DCTL, DALEPENA, GUSB2PHYCFG, DEPCMDPAR1, DEPCMDPAR0, DEPCMD</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">1. Event buffer initialization successful&#10;2. DSTS microframe alignment achieved&#10;3. EP0 and EP1 endpoint commands complete&#10;4. Bulk data transfer completes&#10;5. All interrupts serviced&#10;6. GIC IRQ 84 cleared</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String"></Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="Data"><Data ss:Type="String">3</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">USB</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">USB Full-Speed Device Isochronous Transfer (DWC3)</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">USB_FS_Device_Isochronous_Transfer_test</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">Verifies USB device-mode isochronous data transfer at full-speed using DWC3. Initializes event buffer, configures device registers, sets up EP0, EP1, and EP6 (isochronous) endpoints, performs control transfer setup and isochronous data transfers (OUT and IN) with 1023-byte payloads.</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">Full-Speed</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">Device</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">NA</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">NA</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">Debug markers 0xdeadbee5, 0xdeadbee6, 0xdeadbee8 at 0xA0243ffc. LSS SYSREG macros unresolved. IRQ handler uses logical AND (&amp;&amp;) instead of bitwise AND (&amp;). +0x10 for EP1, +0x60 for EP6 isochronous. 1023-byte payload consistent with FS isochronous max.</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">1. Initialize NIC and GIC interrupts&#10;2. Configure event buffer&#10;3. Read global control and device config&#10;4. Poll DSTS for microframe alignment&#10;5. Configure device and enable endpoints&#10;6. Configure USB2 PHY&#10;7. Set up EP0, EP1, and EP6 (isochronous) via DEPCMD&#10;8. Execute control transfer setup&#10;9. Perform isochronous OUT and IN transfers&#10;10. Service interrupts via IRQ handler</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">GEVNTADRLO, GEVNTADRHI, GEVNTSIZ, GEVNTCOUNT, GCTL, DCFG, DSTS, DCTL, DALEPENA, GUSB2PHYCFG, DEPCMDPAR1, DEPCMDPAR0, DEPCMD</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">1. Event buffer initialization successful&#10;2. DSTS microframe alignment achieved&#10;3. EP0, EP1, EP6 endpoint commands complete&#10;4. Isochronous OUT and IN transfers complete&#10;5. All interrupts serviced&#10;6. GIC IRQ 84 cleared</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String"></Data></Cell>
   </Row>
  </Table>
  <WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel">
   <FreezePanes/>
   <FrozenNoSplit/>
   <SplitHorizontal>1</SplitHorizontal>
   <TopRowBottomPane>1</TopRowBottomPane>
  </WorksheetOptions>
 </Worksheet>
 <Worksheet ss:Name="MetaData">
  <Table>
   <Column ss:Width="40"/>
   <Column ss:Width="220"/>
   <Column ss:Width="400"/>
   <Column ss:Width="400"/>
   <Column ss:Width="300"/>
   <Column ss:Width="300"/>
   <Column ss:Width="200"/>
   <Column ss:Width="400"/>
   <Column ss:Width="400"/>
   <Row>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Index</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Test Case Name</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Meta Test Description</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Meta Test Steps / Procedure</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Meta Impacted Registers</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Meta Validation / Acceptance Criteria</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Meta Headers</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Meta Macros</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">Meta Arrays</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="Data"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">usb_host_enumeration_ls</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">USB host-mode enumeration of a low-speed device using xHCI host controller. Configures PHY, reads capability parameters, sets up DCBAA, Command Ring, Event Ring, enables interrupts, performs port connect detection, port reset, Enable Slot, Address Device commands, and GET_DESCRIPTOR control transfer.</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">1. nic_programming() and GIC_EnableAllIRQ()&#10;2. Configure PHY at MIZAR_USB_BASE+0xc200&#10;3. Read HCSPARAMS1, SUPTPRT2_DW2, SUPTPRT3_DW2&#10;4. Configure PORTSC_20 with WCE/WDE/WOE&#10;5. Read DBOFF, configure CONFIG&#10;6. Set DCBAAP_LO/HI, CRCR_LO/HI&#10;7. Configure ERSTSZ, ERDP, ERSTBA, IMOD, IMAN&#10;8. Write Enable Slot Command TRB&#10;9. Enable system interrupt, start host controller&#10;10. Wait for port connect interrupt&#10;11. Port reset sequence&#10;12. Populate Input Context, Address Device Command&#10;13. Ring doorbell, wait for completion&#10;14. Call enumeration() for GET_DESCRIPTOR</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">GUSB2PHYCFG, HCSPARAMS1, SUPTPRT2_DW2, SUPTPRT3_DW2, PORTSC_20, DBOFF, CONFIG, DCBAAP_LO, DCBAAP_HI, CRCR_LO, CRCR_HI, ERSTSZ, ERDP_LO, ERDP_HI, ERSTBA_LO, ERSTBA_HI, IMOD, IMAN, USBCMD, USBSTS, DB</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">1. Port connect interrupt received&#10;2. Port reset completion interrupt received&#10;3. Enable Slot command completes&#10;4. Address Device command completes&#10;5. GET_DESCRIPTOR transfer completes&#10;6. All int_pend wait loops exit&#10;7. System interrupts properly cleared</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">#include &lt;stdio.h&gt;&#10;#include &lt;stdlib.h&gt;&#10;#include "usb.h"</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">MIZAR_USB_BASE, MIZAR_USB_HCSPARAMS1, MIZAR_USB_SUPTPRT2_DW2, MIZAR_USB_SUPTPRT3_DW2, MIZAR_USB_PORTSC_20, USB_PORTSC_20_WCE, USB_PORTSC_20_WDE, USB_PORTSC_20_WOE, MIZAR_USB_DBOFF, MIZAR_USB_CONFIG, MIZAR_USB_DCBAAP_LO, MIZAR_USB_DCBAAP_HI, MIZAR_USB_CRCR_LO, MIZAR_USB_CRCR_HI, MIZAR_USB_ERSTSZ, MIZAR_USB_ERDP_LO, MIZAR_USB_ERDP_HI, MIZAR_USB_ERSTBA_LO, MIZAR_USB_ERSTBA_HI, MIZAR_USB_IMOD, MIZAR_USB_IMAN, MIZAR_USB_USBCMD, MIZAR_LSS_SYSREG_INTR_EN0, MIZAR_USB_USBSTS, MIZAR_USB_DB, MIZAR_LSS_SYSREG_MSK_STS0, MIZAR_LSS_SYSREG_RAW_STCR0</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">int data_in[512]; int data_out[512]; Device_Context_Base_Address_Array; Event_Ring_Segment_Table; Default_Input_Context; Enable Slot Command TRB; Address Device Command TRB; GET_DESCRIPTOR TRBs</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="Data"><Data ss:Type="String">2</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">USB_FS_Device_Bulk_Transfer_test</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">USB device-mode bulk transfer at full-speed using DWC3 controller. Initializes event buffer, reads GCTL/DCFG/DSTS, polls for microframe alignment, configures endpoints via DEPCMD commands, performs bulk data transfers with TRB-based DMA.</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">1. nic_programming() and GIC_EnableAllIRQ()&#10;2. Initialize event buffer (GEVNTADRLO/HI/SIZ/COUNT)&#10;3. Read GCTL, DCFG, DSTS&#10;4. Poll DSTS for microframe alignment&#10;5. Configure DCFG, DCTL, DALEPENA&#10;6. setup_stage() and GUSB2PHYCFG config&#10;7. EP0 DEPCMD Start New Configuration (0x401)&#10;8. EP1 DEPCMD+0x10 Start Transfer (0x506)&#10;9. Wait for interrupts, perform bulk transfers&#10;10. Debug marker at 0xA0243ffc</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">GEVNTADRLO, GEVNTADRHI, GEVNTSIZ, GEVNTCOUNT, GCTL, DCFG, DSTS, DCTL, DALEPENA, GUSB2PHYCFG, DEPCMDPAR1, DEPCMDPAR0, DEPCMD</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">1. Event buffer initialized&#10;2. DSTS poll exits on microframe alignment&#10;3. EP0 DEPCMD 0x401 completes&#10;4. EP1 DEPCMD+0x10 0x506 completes&#10;5. Bulk transfers complete with interrupts&#10;6. All int_pend loops exit</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">#include &lt;stdio.h&gt;&#10;#include &lt;stdlib.h&gt;&#10;#include "usb.h"</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">MIZAR_USB_GEVNTADRLO, MIZAR_USB_GEVNTADRHI, MIZAR_USB_GEVNTSIZ, MIZAR_USB_GEVNTCOUNT, MIZAR_USB_GCTL, MIZAR_USB_DCFG, MIZAR_USB_DSTS, MIZAR_USB_DCTL, MIZAR_USB_DALEPENA, MIZAR_USB_GUSB2PHYCFG, MIZAR_USB_DEPCMDPAR1, MIZAR_USB_DEPCMDPAR0, MIZAR_USB_DEPCMD, MIZAR_LSS_SYSREG_MSK_STS0, MIZAR_LSS_SYSREG_RAW_STCR0, 0xA0243ffc</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">int buf_data[16]; Default_Event_Ring_Array; Buffer_PointerLO; Buffer_PointerLO_1; EP0_TR_Dequeue_Pointer; event_trb_addr</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="Data"><Data ss:Type="String">3</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">USB_FS_Device_Isochronous_Transfer_test</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">USB device-mode isochronous transfer at full-speed using DWC3 controller. Similar initialization to bulk test but additionally configures EP6 (isochronous) via DEPCMD+0x60. Performs isochronous OUT and IN transfers with 1023-byte payloads. Multiple debug markers at various stages.</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">1. nic_programming() and GIC_EnableAllIRQ()&#10;2. Initialize event buffer (GEVNTADRLO/HI/SIZ/COUNT)&#10;3. Read GCTL, DCFG, DSTS&#10;4. Poll DSTS for microframe alignment&#10;5. Configure DCFG, DCTL, DALEPENA&#10;6. setup_stage() and GUSB2PHYCFG config&#10;7. EP0 DEPCMD Start New Configuration (0x401)&#10;8. EP1 DEPCMD+0x10 Start Transfer (0x506)&#10;9. EP6 DEPCMD+0x60 Start Transfer&#10;10. Isochronous OUT/IN transfers with 0x3ff payloads&#10;11. Debug markers at 0xA0243ffc</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">GEVNTADRLO, GEVNTADRHI, GEVNTSIZ, GEVNTCOUNT, GCTL, DCFG, DSTS, DCTL, DALEPENA, GUSB2PHYCFG, DEPCMDPAR1, DEPCMDPAR0, DEPCMD</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">1. Event buffer initialized&#10;2. DSTS poll exits on microframe alignment&#10;3. EP0, EP1, EP6 DEPCMD commands complete&#10;4. Isochronous OUT transfers complete with 1023-byte payloads&#10;5. Isochronous IN transfers complete&#10;6. All int_pend loops exit</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">#include &lt;stdio.h&gt;&#10;#include &lt;stdlib.h&gt;&#10;#include "usb.h"</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">MIZAR_USB_GEVNTADRLO, MIZAR_USB_GEVNTADRHI, MIZAR_USB_GEVNTSIZ, MIZAR_USB_GEVNTCOUNT, MIZAR_USB_GCTL, MIZAR_USB_DCFG, MIZAR_USB_DSTS, MIZAR_USB_DCTL, MIZAR_USB_DALEPENA, MIZAR_USB_GUSB2PHYCFG, MIZAR_USB_DEPCMDPAR1, MIZAR_USB_DEPCMDPAR0, MIZAR_USB_DEPCMD, MIZAR_LSS_SYSREG_MSK_STS0, MIZAR_LSS_SYSREG_RAW_STCR0, 0xA0243ffc</Data></Cell>
    <Cell ss:StyleID="Data"><Data ss:Type="String">int buf_data[16]; Default_Event_Ring_Array; Buffer_PointerLO; Buffer_PointerLO_1; EP0_TR_Dequeue_Pointer; event_trb_addr</Data></Cell>
   </Row>
  </Table>
  <WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel">
   <Visible>SheetVeryHidden</Visible>
   <FreezePanes/>
   <FrozenNoSplit/>
   <SplitHorizontal>1</SplitHorizontal>
   <TopRowBottomPane>1</TopRowBottomPane>
