@@XLSXGEN@@
import openpyxl, io, base64
from openpyxl.styles import Font, PatternFill, Alignment
from openpyxl.worksheet.datavalidation import DataValidation

wb = openpyxl.Workbook()
hf = Font(bold=True, color="FFFFFF")
hfill = PatternFill(start_color="4472C4", end_color="4472C4", fill_type="solid")
wrap = Alignment(wrap_text=True, vertical="top")

# TestPlan Sheet
ws = wb.active
ws.title = "TestPlan"
tp_cols = ["Index","SS / Module","Feature","Test Case Name","Speed","Mode","Memory Start Offset","Memory End Offset","Test Description","Test Steps / Procedure","Impacted Registers","Validation / Acceptance Criteria","Remarks","Code Generation (Required / Not)"]
for c,h in enumerate(tp_cols,1):
    cell = ws.cell(row=1, column=c, value=h)
    cell.font = hf
    cell.fill = hfill
    cell.alignment = wrap

data = {"Index":"1","SS / Module":"USB","Feature":"Full-Speed Device Bulk Transfer","Test Case Name":"USB_FS_Device_Bulk_Transfer_test","Speed":"Full-Speed","Mode":"Device","Memory Start Offset":"NA","Memory End Offset":"NA"}
for c,col in enumerate(tp_cols[:14],1):
    ws.cell(row=2, column=c, value=data.get(col,"")).alignment = wrap

dv = DataValidation(type="list", formula1='"Required,Not Required"', allow_blank=True)
dv.sqref = "N2:N2"
ws.add_data_validation(dv)
ws.freeze_panes = "A2"

# MetaData Sheet
md = wb.create_sheet("MetaData")
md.sheet_state = "veryHidden"
md_cols = ["Test Case Name","Meta Headers","Meta Macros","Meta Arrays","Meta Types","Meta Test Description","Meta Test Steps / Procedure","Meta Impacted Registers","Meta Validation / Acceptance Criteria"]
for c,h in enumerate(md_cols,1):
    cell = md.cell(row=1, column=c, value=h)
    cell.font = hf
    cell.fill = hfill
    cell.alignment = wrap
md.cell(row=2, column=1, value="USB_FS_Device_Bulk_Transfer_test").alignment = wrap
md.freeze_panes = "A2"

buf = io.BytesIO()
wb.save(buf)
print(base64.b64encode(buf.getvalue()).decode())
