#define BAR0_FINAL_ADDR         0x0
#define BAR1_FINAL_ADDR         0x4
#define BAR2_FINAL_ADDR         0x20000000
#define BAR3_FINAL_ADDR         0x40000000
#define BAR4_FINAL_ADDR         0x60000000
#define BAR5_FINAL_ADDR         0x80000000

/* SII link status polling mask and expected value */
