/*
 * test_define.cin
 *
 * Test Case : pcie_dma_write_test
 * Purpose   : PCIe DMA write operation test.
 *             Defines macros, headers, and supporting testcase data.
 */

/* Headers */
#include <stdlib.h>
#include <stdio.h>
#include <test_common.h>
#include "pcie.h"

/*
 * Macros from Meta TestPlan JSON.
 * DM0_RC, DM1_RC, DM0_EP, DM1_EP, DEBUG_DISPLAY are compile-time defines
 * expected to be provided via build configuration or command-line flags.
 * They are not defined here to avoid overriding project-level settings.
 */

/* SII link status polling mask and expected value */
#define SII_LINK_STATUS_MASK    0xD1
#define SII_LINK_STATUS_EXPECT  0xD1

/* Completion synchronization expected value */
#define COMPLETION_SYNC_REG     0xE6004100
#define COMPLETION_SYNC_VALUE   0x12345678

/* System-level control register addresses */
#define SYS_CTRL_REG_0          0xE690000C
#define SYS_CTRL_REG_1          0xE6900010
#define SYS_CTRL_REG_2          0xE6900014
#define SYS_CTRL_ENABLE_VAL     0x1

/*
 * DMA channel register addresses.
 * DMA_CH0_SRC_ADDR, DMA_CH0_DST_ADDR, DMA_CH0_XFER_SIZE, DMA_CH0_CTRL,
 * DMA_DOORBELL, DMA_STATUS are listed as impacted registers.
 * Their base addresses must be provided by the platform/IP header (pcie.h).
 * The following value macros are placeholders that must be configured
 * per platform before compilation.
 */

/* DMA channel configuration values - must be set per platform */
#ifndef DMA_CH0_SRC_ADDR_VAL
/* Source address for DMA write transfer - configure per platform */
#define DMA_CH0_SRC_ADDR_VAL    0x0UL
#endif

#ifndef DMA_CH0_DST_ADDR_VAL
/* Destination address for DMA write transfer - configure per platform */
#define DMA_CH0_DST_ADDR_VAL    0x0UL
#endif

#ifndef DMA_CH0_XFER_SIZE_VAL
/* Transfer size for DMA write - configure per platform */
#define DMA_CH0_XFER_SIZE_VAL   0x0UL
#endif

#ifndef DMA_CH0_CTRL_WR_VAL
/* DMA control register value for write direction - configure per platform */
#define DMA_CH0_CTRL_WR_VAL     0x0UL
#endif

#ifndef DMA_DOORBELL_TRIGGER_VAL
/* DMA doorbell trigger value - configure per platform */
#define DMA_DOORBELL_TRIGGER_VAL 0x1UL
#endif

#ifndef DMA_STATUS_DONE_MASK
/* DMA status done mask - configure per platform */
#define DMA_STATUS_DONE_MASK    0x1UL
#endif

#ifndef DMA_EXPECTED_DATA_PATTERN
/* Expected data pattern at destination after DMA write - configure per platform */
#define DMA_EXPECTED_DATA_PATTERN 0x0UL
#endif
