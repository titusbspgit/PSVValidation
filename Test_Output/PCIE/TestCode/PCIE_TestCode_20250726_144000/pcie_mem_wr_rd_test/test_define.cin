#include <stdlib.h>
#include <stdio.h>
#include <test_common.h>
#include "pcie.h"

/ Compile-time defines for PCIe mode selection /
/ DM0_RC - Define to enable DM0 Root Complex mode /
/ DM1_RC - Define to enable DM1 Root Complex mode /
/ DM0_EP - Define to enable DM0 Endpoint mode /
/ DM1_EP - Define to enable DM1 Endpoint mode /
/ DM0 - Define to enable DM0 controller /
/ DM1 - Define to enable DM1 controller /
/ DEBUG_DISPLAY - Define to enable debug display logging /

/ Arrays: NA */
